# Copy to .env and adjust.  (copy .env.example .env)

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Set to true to require the Django admin login for the dashboard
SCOUT_REQUIRE_LOGIN=false

# Claude (via Claude Code CLI on your Pro login - NO API key)
LLM_MODEL=claude-sonnet-5-5
# If `claude` isn't found by Task Scheduler, put the full path here, e.g.
# CLAUDE_CLI=C:\Users\Timothy\AppData\Roaming\npm\claude.cmd
CLAUDE_CLI=claude
# Optional extra CLI flags, e.g. --max-turns 1
CLAUDE_EXTRA_ARGS=
CLAUDE_TIMEOUT_SECONDS=180
# Do NOT set ANTHROPIC_API_KEY. NexScout strips it anyway so it can't bill an API account.

# Sending applications from your Gmail (optional)
# 1. Turn on 2-Step Verification for your Google account.
# 2. Create an App Password: Google Account > Security > App passwords (name it NexScout).
# 3. Paste the 16-character password below. Never use your normal Gmail password.
EMAIL_HOST_USER=arifalotimothy@gmail.com
EMAIL_HOST_PASSWORD=
SENDER_NAME=Timothy Arifalo
# Your CV, attached to every application. Default: cv.pdf in the nexscout folder.
CV_PATH=

# Job boards see this in the User-Agent header
SCOUT_CONTACT_EMAIL=arifalotimothy@gmail.com
HTTP_TIMEOUT_SECONDS=25

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
# DB_NAME=nexscout
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
